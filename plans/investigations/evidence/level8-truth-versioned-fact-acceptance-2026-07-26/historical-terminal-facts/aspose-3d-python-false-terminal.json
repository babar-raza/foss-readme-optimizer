      "fact_id": "example.minimal:agent-drafted-example",
      "field": "example.minimal",
      "value": {
        "language": "python",
        "class_name": "readme_example",
        "code": "from aspose.threed import Scene\nfrom aspose.threed.formats.obj import ObjLoadOptions\n\n# Create a new scene\nscene = Scene()\n\n# Import an OBJ file\noptions = ObjLoadOptions()\noptions.enable_materials = True\noptions.flip_coordinate_system = False\nscene.open(\"model.obj\", options)\n\n# Access imported data\nfor node in scene.root_node.child_nodes:\n    if node.entity:\n        mesh = node.entity\n        print(f\"Mesh: {node.name}\")\n        print(f\"  Vertices: {len(mesh.control_points)}\")\n        print(f\"  Polygons: {mesh.polygon_count}\")\n",
        "verification_outcome": "SOURCE_BUILD_VERIFIED",
        "verification_detail": "source build and exact README example compilation passed"
      },
