      "result": {
        "units": [
          {
            "heading": "Create meshes without boolean operations",
            "text": "Aspose.3D FOSS for Python allows mesh creation and manipulation, but does not support boolean operations such as union, difference, intersection, or generic do_boolean on Mesh instances.",
            "fact_ids": [
              "product.limitations:source-guidance"
            ]
          },
          {
            "heading": "Define NURBS curves and surfaces without evaluation",
            "text": "NURBS curve and surface entities can be declared, but evaluating points on a NURBS curve or converting a NURBS surface to a mesh is not implemented.",
            "fact_ids": [
              "product.limitations:source-guidance"
            ]
          },
          {
            "heading": "Render scenes or configure renderers",
            "text": "Scene rendering and Renderer configuration are not implemented; output generation through the rendering pipeline is unavailable.",
            "fact_ids": [
              "product.limitations:source-guidance"
            ]
          }
        ],
        "omitted": []
