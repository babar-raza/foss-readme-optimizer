        "units": [
          {
            "heading": "Create 3D primitives and scenes",
            "text": "Aspose.3D FOSS for Python enables developers to construct 3D scenes using built-in primitives such as Box, Cylinder, Sphere, Plane, Dish, Circle, Ellipse, and Frustum. These primitives serve as foundational building blocks for modeling geometry programmatically.",
            "fact_ids": [
              "product.problems_solved:capability-derived",
              "product.capabilities:repository-evidence"
            ]
          },
          {
            "heading": "Import and export common 3D file formats",
            "text": "The product supports file format import and export for OBJ, GLTF, STL, and 3MF, allowing users to load existing 3D content or export generated scenes for use in downstream tools and pipelines.",
            "fact_ids": [
              "product.problems_solved:capability-derived",
              "product.capabilities:repository-evidence"
            ]
          },
          {
            "heading": "Define and animate 3D scenes with keyframes",
            "text": "Aspose.3D FOSS for Python includes an animation system with keyframe support, enabling developers to define time-based transformations and motion paths for 3D objects within a scene.",
            "fact_ids": [
              "product.problems_solved:capability-derived",
              "product.capabilities:repository-evidence"
            ]
          }
