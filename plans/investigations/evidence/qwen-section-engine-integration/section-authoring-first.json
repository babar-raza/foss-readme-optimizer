        "units": [
          {
            "heading": "Create 3D content with Aspose.3D FOSS for Python",
            "text": "Aspose.3D FOSS for Python is a Python library for developers to import, export, and manipulate 3D scenes. It supports file format import and export for OBJ, GLTF, STL, and 3MF, and includes an animation system with keyframe support.",
            "fact_ids": [
              "product.identity:manifest-and-registry"
            ]
          },
          {
            "heading": "Define 3D workflows for Python developers",
            "text": "Developers using Python can leverage Aspose.3D FOSS for Python to build applications that process 3D models, automate scene transformations, and integrate 3D data into larger workflows.",
            "fact_ids": [
              "product.audience:platform-derived"
            ]
          }
        ],
        "omitted": []
